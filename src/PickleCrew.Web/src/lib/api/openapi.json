{
  "openapi": "3.1.1",
  "info": {
    "title": "PickleCrew.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/crews": {
      "post": {
        "tags": [
          "CreateCrewEndpoint"
        ],
        "summary": "Creates a crew for the signed-in user.",
        "operationId": "CreateCrew",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCrewHttpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCrewHttpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/crews/invitations": {
      "post": {
        "tags": [
          "SendCrewInvitationEndpoint"
        ],
        "summary": "Sends a crew invitation during onboarding.",
        "operationId": "SendCrewInvitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCrewInvitationHttpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendCrewInvitationHttpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/games/recording-options": {
      "get": {
        "tags": [
          "GetGameRecordingOptionsEndpoint"
        ],
        "summary": "Gets active crew members available for game recording.",
        "operationId": "GetGameRecordingOptions",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetGameRecordingOptionsHttpResponse"
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "post": {
        "tags": [
          "RecordGameEndpoint"
        ],
        "summary": "Records a completed game for the active Crew.",
        "operationId": "RecordGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordGameHttpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordGameHttpResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCrewHttpRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateCrewHttpResponse": {
        "required": [
          "crewId",
          "name",
          "organizationId"
        ],
        "type": "object",
        "properties": {
          "crewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          }
        }
      },
      "CrewInvitationOutcomeStatus": {
        "enum": [
          "sent",
          "already-active-member",
          "already-pending",
          "failed"
        ]
      },
      "GameFormat": {
        "enum": [
          "singles",
          "doubles"
        ]
      },
      "GameRecordingMemberHttpResponse": {
        "required": [
          "userId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GetGameRecordingOptionsHttpResponse": {
        "required": [
          "members"
        ],
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameRecordingMemberHttpResponse"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "required": [
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "traceId": {
            "type": "string",
            "description": "The trace identifier for the request."
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "The trace identifier for the request."
          }
        }
      },
      "RecordedGameParticipantHttpResponse": {
        "required": [
          "slotNumber"
        ],
        "type": "object",
        "properties": {
          "slotNumber": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "guestName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordedGameSideHttpResponse": {
        "required": [
          "sideNumber",
          "score",
          "participants"
        ],
        "type": "object",
        "properties": {
          "sideNumber": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordedGameParticipantHttpResponse"
            }
          }
        }
      },
      "RecordGameHttpRequest": {
        "required": [
          "format",
          "sides"
        ],
        "type": "object",
        "properties": {
          "format": {
            "$ref": "#/components/schemas/GameFormat"
          },
          "sides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordGameSideHttpRequest"
            }
          }
        }
      },
      "RecordGameHttpResponse": {
        "required": [
          "gameId",
          "crewId",
          "format",
          "recorderUserId",
          "playedAtUtc",
          "sides"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "crewId": {
            "type": "string",
            "format": "uuid"
          },
          "format": {
            "$ref": "#/components/schemas/GameFormat"
          },
          "recorderUserId": {
            "type": "string"
          },
          "playedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "sides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordedGameSideHttpResponse"
            }
          }
        }
      },
      "RecordGameParticipantHttpRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "guestName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordGameSideHttpRequest": {
        "required": [
          "score",
          "participants"
        ],
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecordGameParticipantHttpRequest"
            }
          }
        }
      },
      "SendCrewInvitationHttpRequest": {
        "required": [
          "emailAddress"
        ],
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string"
          }
        }
      },
      "SendCrewInvitationHttpResponse": {
        "required": [
          "emailAddress",
          "status"
        ],
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CrewInvitationOutcomeStatus"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "CreateCrewEndpoint"
    },
    {
      "name": "SendCrewInvitationEndpoint"
    },
    {
      "name": "GetGameRecordingOptionsEndpoint"
    },
    {
      "name": "RecordGameEndpoint"
    }
  ]
}