  "components": {
    "schemas": {
      "CreateCrewHttpRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateCrewHttpResponse": {
        "required": [
          "crewId",
          "name",
          "organizationId"
        ],
        "type": "object",
        "properties": {
          "crewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          }
        }
      },
      "CrewInvitationOutcomeStatus": {
        "enum": [
          "sent",
          "already-active-member",
          "already-pending",
          "failed"
        ]
      },
      "CrewLeaderboardEntryHttpResponse": {
        "required": [
          "userId",
          "displayName",
          "rank",
          "wins",
          "losses",
          "crewScore"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "rank": {
            "type": "integer",
            "format": "int32"
          },
          "wins": {
            "type": "integer",
            "format": "int64"
          },
          "losses": {
            "type": "integer",
            "format": "int64"
          },
          "crewScore": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CrewMemberHttpResponse": {
        "required": [
          "id",
          "displayName",
          "emailAddress",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "emailAddress": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CrewRosterEntryStatus"
          },
          "role": {
            "type": [
              "null",
              "string"
            ]
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CrewRosterEntryStatus": {
        "enum": [
          "active",
          "pending"
        ]
      },
      "GameFormat": {
        "enum": [
          "singles",
          "doubles"
        ]
      },
      "GameHistoryItemHttpResponse": {
        "required": [
          "gameId",
          "format",
          "playedAtUtc",
          "sides"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string",
            "format": "uuid"
          },
          "format": {
            "$ref": "#/components/schemas/GameFormat"
          },
          "playedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "sides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameHistorySideHttpResponse"
            }
          }
        }
      },
      "GameHistoryParticipantHttpResponse": {
        "required": [
          "displayName",
          "isGuest"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "isGuest": {
            "type": "boolean"
          }
        }
      },
      "GameHistorySideHttpResponse": {
        "required": [
          "sideNumber",
          "score",
          "participants"
        ],
        "type": "object",
        "properties": {
          "sideNumber": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameHistoryParticipantHttpResponse"
            }
          }
        }
      },
      "GameRecordingMemberHttpResponse": {
        "required": [
          "userId",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GetCrewLeaderboardHttpResponse": {
        "required": [
          "entries"
        ],
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CrewLeaderboardEntryHttpResponse"
            }
          }
        }
      },
      "GetCrewLongestWinStreakHttpResponse": {
        "required": [
          "userId",
          "displayName",
          "longestWinStreak",
          "longestWinStreakStartedAtUtc",
          "longestWinStreakEndedAtUtc"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "profilePictureUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "longestWinStreak": {
            "type": "integer",
            "format": "int64"
          },
          "longestWinStreakStartedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "longestWinStreakEndedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "GetGameRecordingOptionsHttpResponse": {
        "required": [
          "members"
        ],
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameRecordingMemberHttpResponse"
            }
          }
        }
      },
      "GetPersonalStatisticsHttpResponse": {
        "required": [
          "wins",
          "losses",
          "gamesPlayed",
          "currentWinStreak",
          "currentWinStreakStartedAtUtc",
          "longestWinStreak",
          "longestWinStreakStartedAtUtc",
          "longestWinStreakEndedAtUtc",
          "winPercentage",
          "pointsScored",
          "pointsConceded",
          "pointDifferential",
          "crewScore",
          "crewRank",
          "activeCrewMemberCount"
        ],
        "type": "object",
        "properties": {
          "wins": {
            "type": "integer",
            "format": "int64"
          },
          "losses": {
            "type": "integer",
            "format": "int64"
          },
          "gamesPlayed": {
            "type": "integer",
            "format": "int64"
          },
          "currentWinStreak": {
            "type": "integer",
            "format": "int64"
          },
          "currentWinStreakStartedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "longestWinStreak": {
            "type": "integer",
            "format": "int64"
          },
          "longestWinStreakStartedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "longestWinStreakEndedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "winPercentage": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "pointsScored": {
            "type": "integer",
            "format": "int64"
          },
          "pointsConceded": {
            "type": "integer",
            "format": "int64"
          },
          "pointDifferential": {
            "type": "integer",
            "format": "int64"
          },
          "crewScore": {
            "type": "integer",
            "format": "int64"
          },
          "crewRank": {
            "type": "integer",
            "format": "int32"
          },
          "activeCrewMemberCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "GetRecentGamesHttpResponse": {
        "required": [
          "games",
          "wins",
          "losses",
          "winStreak"
        ],
        "type": "object",
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentGameItemHttpResponse"
            }
          },
          "wins": {
            "type": "integer",
            "format": "int32"
          },
          "losses": {
            "type": "integer",
            "format": "int32"
          },
          "winStreak": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "required": [
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
