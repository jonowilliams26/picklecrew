{
  "$schema": "../../src/PickleCrew.Web/node_modules/wrangler/config-schema.json",
  "name": "picklecrew-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "env": {
    "development": {
      "name": "picklecrew-web-development",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dev.picklecrew.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "WORKOS_REDIRECT_URI": "https://dev.picklecrew.app/api/auth/callback"
      },
      "secrets": {
        "required": [
          "WORKOS_CLIENT_ID",
          "WORKOS_API_KEY",
          "WORKOS_COOKIE_PASSWORD"
        ]
      }
    },
    "production": {
      "name": "picklecrew-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "picklecrew.app",
          "custom_domain": true
        }
      ],
      "vars": {
        "WORKOS_REDIRECT_URI": "https://picklecrew.app/api/auth/callback"
      },
      "secrets": {
        "required": [
          "WORKOS_CLIENT_ID",
          "WORKOS_API_KEY",
          "WORKOS_COOKIE_PASSWORD"
        ]
      }
    }
  }
}
